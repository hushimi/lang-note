# React/TypeScript Frontend Patterns

This project uses React 19 with TypeScript, InertiaJS, Tailwind CSS, and Shadcn/ui.

## Tech Stack

- **React 19** - Functional components only
- **TypeScript** - Strict mode enabled
- **InertiaJS** - Modern monolith, no separate API
- **Tailwind CSS** - Utility-first CSS
- **Shadcn/ui** - Component library
- **FontAwesome** - Icon library
- **Vite** - Build tool with HMR

## Code Formatting

- **Indentation**: 2 spaces
- **Line width**: 100 characters max
- **Quotes**: Single quotes
- **Semicolons**: Required

## Component Architecture

### Page Components (resources/js/Pages/)

Page components are InertiaJS pages rendered from Laravel controllers:

```typescript
// ✅ GOOD - Page component with proper types
import { PageProps } from '@/types';
import { UserData, PostData } from '@/types/generated';

interface DashboardProps extends PageProps {
  posts: PostData[];
}

export default function Dashboard({ auth, posts }: DashboardProps) {
  return (
    <div>
      <h1>Welcome, {auth.user?.name}</h1>
      {posts.map((post) => (
        <div key={post.id}>{post.title}</div>
      ))}
    </div>
  );
}

// ❌ BAD - Missing types, not extending PageProps
export default function Dashboard({ auth, posts }: any) {
  return <div>Content</div>;
}
```

### UI Components (resources/js/Components/ui/)

Use Shadcn/ui components for UI primitives:

```typescript
// ✅ GOOD - Use existing Shadcn/ui components
import { Button } from '@/Components/ui/button';
import { Card, CardHeader, CardTitle, CardContent } from '@/Components/ui/card';

<Button variant="outline" size="lg">Click Me</Button>
<Card>
  <CardHeader>
    <CardTitle>Title</CardTitle>
  </CardHeader>
  <CardContent>Content here</CardContent>
</Card>

// ❌ BAD - Create custom buttons instead of using Shadcn
<button className="rounded-md px-4 py-2 bg-blue-500">Click Me</button>
```

### Shared Components (resources/js/Components/)

Create app-specific reusable components here:

```typescript
// ✅ GOOD - Reusable component with proper types
interface UserAvatarProps {
  user: UserData;
  size?: 'sm' | 'md' | 'lg';
}

export function UserAvatar({ user, size = 'md' }: UserAvatarProps) {
  return (
    <img
      src={user.avatar || '/default-avatar.png'}
      alt={user.name}
      className={cn(
        'rounded-full',
        size === 'sm' && 'h-8 w-8',
        size === 'md' && 'h-12 w-12',
        size === 'lg' && 'h-16 w-16'
      )}
    />
  );
}
```

## InertiaJS Patterns

### Navigation

Always use InertiaJS router, never regular links:

```typescript
// ✅ GOOD - InertiaJS navigation
import { Link, router } from '@inertiajs/react';

// For links
<Link href="/dashboard" className="text-blue-500">Dashboard</Link>

// For programmatic navigation
router.visit('/posts');
router.get('/posts/1');
router.post('/posts', formData);
router.delete('/posts/1');

// With callbacks
router.post('/posts', data, {
  onSuccess: () => console.log('Success!'),
  onError: (errors) => console.error(errors),
});

// ❌ BAD - Regular links or window.location
<a href="/dashboard">Dashboard</a>
window.location.href = '/posts';
fetch('/api/posts').then(...);
```

### Form Handling

Use InertiaJS form handling:

```typescript
// ✅ GOOD - InertiaJS form handling
import { useForm } from '@inertiajs/react';

const { data, setData, post, processing, errors } = useForm({
  title: '',
  content: '',
});

const handleSubmit = (e: React.FormEvent) => {
  e.preventDefault();
  post('/posts');
};

<form onSubmit={handleSubmit}>
  <input
    value={data.title}
    onChange={(e) => setData('title', e.target.value)}
  />
  {errors.title && <span>{errors.title}</span>}
  <button disabled={processing}>Submit</button>
</form>

// ❌ BAD - Manual form submission
const handleSubmit = async (e) => {
  e.preventDefault();
  const response = await fetch('/posts', {
    method: 'POST',
    body: JSON.stringify(formData),
  });
};
```

### Receiving Props

All page components receive PageProps:

```typescript
// ✅ GOOD - Extend PageProps for additional props
import { PageProps } from '@/types';

interface ShowProps extends PageProps {
  post: PostData;
  comments: CommentData[];
}

export default function Show({ auth, post, comments }: ShowProps) {
  // auth.user is available via PageProps
  return <div>{post.title}</div>;
}

// ❌ BAD - Not using PageProps
export default function Show(props: any) {
  return <div>{props.post.title}</div>;
}
```

## Type Safety

### Use Generated Types

Always import types generated from PHP Data classes:

```typescript
// ✅ GOOD - Use generated types from PHP
import { UserData, PostData } from '@/types/generated';

interface Props extends PageProps {
  post: PostData;
  author: UserData;
}

// ❌ BAD - Manually define types that exist in backend
interface Props extends PageProps {
  post: {
    id: number;
    title: string;
    content: string;
  };
}
```

### Type All Props and State

```typescript
// ✅ GOOD - Properly typed
interface PostCardProps {
  post: PostData;
  onDelete?: (id: number) => void;
}

const [isLoading, setIsLoading] = useState<boolean>(false);

// ❌ BAD - Implicit any
const [isLoading, setIsLoading] = useState();
function PostCard({ post, onDelete }) {
  return <div>{post.title}</div>;
}
```

### Avoid 'any' Type

```typescript
// ✅ GOOD - Specific types
const handleClick = (event: React.MouseEvent<HTMLButtonElement>) => {
  console.log(event.currentTarget);
};

// ❌ BAD - Using any
const handleClick = (event: any) => {
  console.log(event.currentTarget);
};
```

## Tailwind CSS Patterns

### Use Utility Classes

```typescript
// ✅ GOOD - Tailwind utilities
<div className="flex items-center justify-between rounded-lg bg-white p-4 shadow-md">
  <h2 className="text-xl font-bold">Title</h2>
</div>

// ❌ BAD - Inline styles
<div style={{
  display: 'flex',
  padding: '1rem',
  backgroundColor: 'white'
}}>
  <h2 style={{ fontSize: '1.25rem', fontWeight: 'bold' }}>Title</h2>
</div>
```

### Conditional Classes with cn()

```typescript
// ✅ GOOD - Use cn() utility for conditional classes
import { cn } from '@/lib/utils';

<Button
  className={cn(
    'w-full',
    isActive && 'bg-primary',
    isDisabled && 'opacity-50 cursor-not-allowed'
  )}
/>

// ❌ BAD - String concatenation or template literals
<Button
  className={`w-full ${isActive ? 'bg-primary' : ''} ${isDisabled ? 'opacity-50' : ''}`}
/>
```

### Responsive Design

```typescript
// ✅ GOOD - Mobile-first responsive design
<div className="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  {items.map(item => <Card key={item.id} />)}
</div>

// ✅ GOOD - Responsive text and spacing
<h1 className="text-2xl font-bold md:text-3xl lg:text-4xl">Title</h1>
<div className="space-y-4 p-4 md:p-6 lg:p-8">Content</div>
```

